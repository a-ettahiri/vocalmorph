{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "bun *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "rm *": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "skill": "allow",
    "lsp": "allow",
    "question": "allow",
    "todowrite": "allow",
    "external_directory": "ask",
    "doom_loop": "ask"
  },
  "mcp": {
    "figma": {
      "type": "local",
      "command": ["npx", "-y", "mcp-figma"],
      "enabled": true
    }
  }
}
