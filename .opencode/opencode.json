{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "mkfs *": "deny",
      "dd *": "deny",
      "shutdown *": "deny",
      "reboot *": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "task": "allow",
    "skill": "allow",
    "lsp": "allow",
    "question": "allow",
    "todowrite": "allow",
    "external_directory": "allow",
    "doom_loop": "allow"
  }
}
